# ============ 应用 ============
APP_ENV=dev
DEBUG=true
HOST=0.0.0.0
PORT=8000
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ============ MySQL 8.0 ============
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DB=batch_test
MYSQL_POOL_SIZE=10
MYSQL_POOL_RECYCLE=1800
# 如需整体覆盖连接串（异步驱动为 aiomysql），设置该项后上面的 MySQL_* 将不再生效
# DATABASE_URL=mysql+aiomysql://root:root@127.0.0.1:3306/batch_test?charset=utf8mb4

# ============ Redis ============
REDIS_URL=redis://127.0.0.1:6379/1
REDIS_KEY_PREFIX=batchtest:

# ============ 安全 ============
# 用于 AES/Fernet 加密环境变量与模型 Key，生产环境务必替换
SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ============ 引擎默认值 ============
DEFAULT_CONCURRENCY=3
DEFAULT_QPS_LIMIT=5
PASS_THRESHOLD=60
HTTP_TIMEOUT_SECONDS=60
MAX_TURNS_HARD_LIMIT=20
REPETITION_SIMILARITY_THRESHOLD=0.9
TASK_RETENTION_DAYS=30

# ============ 内置 Mock（用于离线自测） ============
MOCK_LLM_BASE_URL=http://127.0.0.1:8001/v1
MOCK_TARGET_BASE_URL=http://127.0.0.1:8002
