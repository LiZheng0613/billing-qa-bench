# ============ 应用 ============
APP_ENV=dev
DEBUG=true
# 应用显示名（日志与页面标题）
APP_NAME=问账智能客服批量测试平台
HOST=0.0.0.0
PORT=8000
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ============ PostgreSQL 15+ ============
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=batch_test
# 建库时连接的维护库，通常保持 postgres 即可
POSTGRES_MAINTENANCE_DB=postgres
POSTGRES_POOL_SIZE=10
POSTGRES_POOL_RECYCLE=1800
# 如需整体覆盖连接串（异步驱动为 asyncpg，同步迁移驱动为 psycopg），设置该项后上面的 POSTGRES_* 将不再生效
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/batch_test

# ============ Redis ============
REDIS_URL=redis://127.0.0.1:6379/1
REDIS_KEY_PREFIX=batchtest:

# ============ 安全 ============
# 用于 AES/Fernet 加密环境变量与模型 Key，生产环境务必替换
SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ============ 引擎默认值 ============
DEFAULT_CONCURRENCY=3
DEFAULT_QPS_LIMIT=5
SCHEDULE_POLL_INTERVAL_SECONDS=15
PASS_THRESHOLD=60
HTTP_TIMEOUT_SECONDS=60
MAX_TURNS_HARD_LIMIT=20
REPETITION_SIMILARITY_THRESHOLD=0.9
TASK_RETENTION_DAYS=30

# ============ LLM JSON 输出修复重试 ============
# 模型返回 200 但内容不是约定 JSON（Markdown / 噪声 / 缺字段）时，带纠错提示继续重试的次数；
# 总调用次数 = 1 + LLM_JSON_RETRY_ATTEMPTS
LLM_JSON_RETRY_ATTEMPTS=2
# 每次重试前的基准退避秒数（指数递增并带随机抖动，单次上限 8s）
LLM_JSON_RETRY_BACKOFF_SECONDS=1.0

# ============ 内置 Mock（用于离线自测） ============
MOCK_LLM_BASE_URL=http://127.0.0.1:8001/v1
MOCK_TARGET_BASE_URL=http://127.0.0.1:8002
